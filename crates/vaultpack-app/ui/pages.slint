import { ComboBox, ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, PButton, IconButton, Card, IconTile, Check3, DashedBox, Field, Toggle } from "widgets.slint";
import { App, Tr, ItemRow, TreeRow, BrowserRow } from "state.slint";

component PageHeader inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> sub;
    height: 64px;
    HorizontalLayout {
        spacing: 14px;
        alignment: Theme.rtl ? end : start;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: title; color: Theme.text; font-size: 34px; font-weight: 800; horizontal-alignment: Theme.start; }
            Text { text: sub; color: Theme.sub; font-size: 15px; font-weight: 500; horizontal-alignment: Theme.start; }
        }
    }
}

component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.amber;
    in property <string> action;
    callback act;
    height: 46px;
    border-radius: 16px;
    background: tone.with-alpha(0.16);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout { alignment: center; Icon { d: Icons.warning; tint: tone; size: 20px; } }
        Text { text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-alignment: Theme.start; }
        if action != "": VerticalLayout { alignment: center; PButton { text: action; width: 220px; height: 30px; clicked => { root.act(); } } }
    }
}

component PresetCard inherits Card {
    in property <string> icon;
    in property <string> title;
    in property <string> sub;
    in-out property <bool> on;
    callback toggled(bool);
    height: 176px;
    VerticalLayout {
        padding: 18px;
        spacing: 4px;
        HorizontalLayout {
            IconTile { icon: root.icon; tile: 40px; }
            Rectangle { horizontal-stretch: 1; }
            Toggle { checked <=> root.on; toggled(v) => { root.toggled(v); } }
        }
        Rectangle { vertical-stretch: 1; }
        Text { text: title; color: Theme.text; font-size: 17px; font-weight: 700; overflow: elide; horizontal-alignment: Theme.start; }
        Text { text: sub; color: Theme.sub; font-size: 12px; wrap: word-wrap; max-height: 34px; overflow: elide; horizontal-alignment: Theme.start; }
    }
}

export component BackupPage inherits Rectangle {
    VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            spacing: 8px;
            PageHeader { icon: Icons.folder; title: Tr.backup; sub: Tr.backup-sub; }
            VerticalLayout { alignment: center; PButton { text: Tr.save-profile; primary: false; width: 124px; clicked => { App.save-profile(); } } }
            VerticalLayout { alignment: center; PButton { text: Tr.load-profile; primary: false; width: 124px; clicked => { App.load-profile(); } } }
        }
        if App.need-admin: Banner { text: App.status; action: Tr.relaunch; act => { App.relaunch-admin(); } }
        ScrollView {
            VerticalLayout {
                spacing: 14px;
                padding-right: 10px;
                Rectangle {
                    height: 168px;
                    DashedBox {
                        active: App.dragging;
                        TouchArea { mouse-cursor: pointer; clicked => { App.add-files(); } }
                        VerticalLayout {
                            alignment: center;
                            spacing: 5px;
                            Icon { d: Icons.backup; size: 40px; tint: Theme.accent; x: (parent.width - self.width) / 2; }
                            Text { text: Tr.drop-title; color: Theme.text; font-size: 20px; font-weight: 800; horizontal-alignment: center; }
                            Text { text: Tr.drop-sub; color: Theme.sub; font-size: 13px; horizontal-alignment: center; }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding-top: 6px;
                                PButton { text: Tr.add-files; icon: Icons.file; primary: false; width: 130px; height: 32px; clicked => { App.add-files(); } }
                                PButton { text: Tr.add-folder; icon: Icons.folder; primary: false; width: 130px; height: 32px; clicked => { App.add-folder(); } }
                            }
                        }
                    }
                }
                Card {
                    height: 62px + Math.min(4, Math.max(1, App.items.length)) * 52px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text { text: Tr.selected-items + " (" + App.items.length + ")"; color: Theme.text; font-size: 20px; font-weight: 800; horizontal-alignment: Theme.start; }
                        if App.items.length == 0: Text { text: Tr.no-items; color: Theme.sub; font-size: 13px; horizontal-alignment: Theme.start; }
                        ListView {
                            for it[i] in App.items: Rectangle {
                                height: 52px;
                                background: ra.has-hover ? Theme.card-hover : transparent;
                                border-radius: 12px;
                                ra := TouchArea { }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 12px;
                                    VerticalLayout { alignment: center; Icon { d: it.folder ? Icons.folder : Icons.file; tint: Theme.accent; size: 24px; } }
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: it.name; color: Theme.text; font-size: 14px; overflow: elide; horizontal-alignment: Theme.start; }
                                        Text { text: it.detail; color: Theme.sub; font-size: 12px; overflow: elide; horizontal-alignment: Theme.start; }
                                    }
                                    VerticalLayout { alignment: center; IconButton { icon: Icons.close; clicked => { App.remove-item(i); } } }
                                }
                            }
                        }
                    }
                }
                Text { text: Tr.presets; color: Theme.text; font-size: 22px; font-weight: 800; horizontal-alignment: Theme.start; }
                HorizontalLayout {
                    spacing: 14px;
                    PresetCard { icon: Icons.globe; title: Tr.browsers; sub: Tr.browsers-sub; on <=> App.preset-browsers; toggled(v) => { App.preset-changed(0, v); } }
                    PresetCard { icon: Icons.wifi; title: Tr.wifi; sub: Tr.wifi-sub; on <=> App.preset-wifi; toggled(v) => { App.preset-changed(1, v); } }
                    PresetCard { icon: Icons.apps; title: Tr.programs; sub: Tr.programs-sub; on <=> App.preset-programs; toggled(v) => { App.preset-changed(2, v); } }
                }
                if App.preset-browsers: Card {
                    height: 56px + App.browser-rows.length * 34px + (App.browser-rows.length == 0 ? 24px : 0px) + (App.browser-running ? 46px : 0px);
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        Text { text: Tr.browsers-note; color: Theme.amber; font-size: 12px; wrap: word-wrap; horizontal-alignment: Theme.start; }
                        if App.browser-rows.length == 0: Text { text: "No supported browser profiles were found."; color: Theme.sub; font-size: 13px; horizontal-alignment: Theme.start; }
                        for b[i] in App.browser-rows: Rectangle {
                            height: 34px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout { alignment: center; Check3 { state: b.checked ? 1 : 0; toggled => { App.browser-toggled(i, !b.checked); } } }
                                Text { text: b.label + (b.running ? "  (running)" : ""); color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-alignment: Theme.start; }
                                Text { text: b.size; color: Theme.sub; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                            }
                            TouchArea { clicked => { App.browser-toggled(i, !b.checked); } }
                        }
                        if App.browser-running: HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Some browsers are running. Close them or the backup may skip locked files."; color: Theme.sub; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                            VerticalLayout { alignment: center; PButton { text: Tr.close-browsers; width: 150px; height: 30px; primary: false; clicked => { App.close-browsers(); } } }
                        }
                    }
                }
                if App.preset-wifi && App.password == "": Banner { text: Tr.wifi-warn; tone: Theme.red; }
                Card {
                    height: 104px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: Tr.excludes; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-alignment: Theme.start; }
                        HorizontalLayout {
                            spacing: 10px;
                            Field { text <=> App.excludes; placeholder: Tr.excludes-ph; }
                            ComboBox { model: ["+ Temp", "+ Developer", "+ Caches", "+ System junk"]; width: 160px; current-index: -1; selected(v) => { App.add-exclude-preset(self.current-index); } }
                        }
                    }
                }
                Card {
                    height: 118px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: Theme.rtl ? end : start;
                            VerticalLayout { alignment: center; Icon { d: Icons.lock; size: 18px; tint: Theme.accent; } }
                            Text { text: Tr.password; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                            VerticalLayout { alignment: center; Icon { d: Icons.info; size: 15px; tint: Theme.sub; } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Field { text <=> App.password; placeholder: Tr.password-ph; secret: !App.show-password; }
                            IconButton { icon: Icons.eye; tint: App.show-password ? Theme.accent : Theme.sub; width: 38px; height: 38px; clicked => { App.show-password = !App.show-password; } }
                        }
                        Text { text: Tr.password-tip; color: Theme.sub; font-size: 11px; overflow: elide; horizontal-alignment: Theme.start; }
                    }
                }
            }
        }
        Card {
            height: 72px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 12px;
                spacing: 12px;
                alignment: Theme.rtl ? end : start;
                VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: App.status-kind == 0 ? Theme.green : App.status-kind == 1 ? Theme.amber : Theme.red; } }
                Text { text: App.need-admin || App.status-kind == 0 ? Tr.ready : App.status; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-alignment: Theme.start; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: Tr.compression; color: Theme.sub; font-size: 13px; vertical-alignment: center; }
                VerticalLayout { alignment: center; ComboBox { model: [Tr.fast, Tr.recommended, Tr.maximum]; current-index <=> App.level; width: 150px; } }
                VerticalLayout { alignment: center; PButton { text: Tr.start-backup; icon: Icons.play; width: 170px; height: 44px; enabled: !App.busy; clicked => { App.start-backup(); } } }
            }
        }
    }
}

export component RestorePage inherits Rectangle {
    VerticalLayout {
        spacing: 14px;
        PageHeader { icon: Icons.restore; title: Tr.restore; sub: Tr.restore-sub; }
        if App.need-admin: Banner { text: App.status; action: Tr.relaunch; act => { App.relaunch-admin(); } }
        if !App.archive-open && !App.needs-password: Rectangle {
            vertical-stretch: 1;
            DashedBox {
                active: App.dragging;
                TouchArea { mouse-cursor: pointer; clicked => { App.open-archive(); } }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Icon { d: Icons.restore; size: 56px; tint: Theme.accent; x: (parent.width - self.width) / 2; }
                    Text { text: Tr.open-archive; color: Theme.text; font-size: 26px; font-weight: 800; horizontal-alignment: center; }
                    Text { text: Tr.open-sub; color: Theme.sub; font-size: 13px; horizontal-alignment: center; }
                }
            }
        }
        if App.needs-password: Card {
            height: 128px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: Tr.archive-password; color: Theme.text; font-size: 14px; horizontal-alignment: Theme.start; }
                HorizontalLayout {
                    spacing: 8px;
                    Field { text <=> App.archive-password; secret: true; placeholder: Tr.password; }
                    PButton { text: Tr.unlock; width: 120px; height: 38px; clicked => { App.unlock(); } }
                    PButton { text: Tr.cancel; primary: false; width: 110px; height: 38px; clicked => { App.close-archive(); } }
                }
                Text { text: App.status; color: Theme.red; font-size: 12px; horizontal-alignment: Theme.start; }
            }
        }
        if App.archive-open: VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 10px;
                alignment: Theme.rtl ? end : start;
                VerticalLayout { alignment: center; Icon { d: Icons.file; size: 20px; tint: Theme.accent; } }
                Text { text: App.archive-name; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-alignment: Theme.start; }
                Rectangle { horizontal-stretch: 1; }
                PButton { text: Tr.open-another; icon: Icons.folder; primary: false; height: 32px; width: 150px; clicked => { App.open-archive(); } }
                PButton { text: Tr.close-archive; icon: Icons.close; primary: false; height: 32px; width: 150px; clicked => { App.close-archive(); } }
            }
            HorizontalLayout {
                spacing: 10px;
                Field { text <=> App.search; placeholder: Tr.search; edited(t) => { App.search-changed(t); } }
            }
            HorizontalLayout {
                spacing: 8px;
                PButton { text: Tr.select-all; primary: false; height: 32px; clicked => { App.tree-bulk(0); } }
                PButton { text: Tr.deselect-all; primary: false; height: 32px; clicked => { App.tree-bulk(1); } }
                PButton { text: Tr.invert; primary: false; height: 32px; clicked => { App.tree-bulk(2); } }
                PButton { text: Tr.expand-all; primary: false; height: 32px; clicked => { App.tree-bulk(3); } }
                PButton { text: Tr.collapse-all; primary: false; height: 32px; clicked => { App.tree-bulk(4); } }
            }
            Card {
                vertical-stretch: 1;
                ListView {
                    for row[i] in App.tree-rows: Rectangle {
                        height: 34px;
                        background: ta.has-hover ? Theme.card-hover : transparent;
                        ta := TouchArea { clicked => { App.tree-select(i); } }
                        HorizontalLayout {
                            padding-left: 12px + row.depth * 20px;
                            padding-right: 12px;
                            spacing: 8px;
                            Rectangle {
                                width: 20px;
                                if row.has-children: Icon { d: row.expanded ? Icons.chevron-down : Icons.chevron-right; size: 18px; tint: Theme.sub; x: 1px; y: (parent.height - self.height) / 2; }
                                if row.has-children: TouchArea { clicked => { App.tree-expand(i); } }
                            }
                            VerticalLayout { alignment: center; Check3 { state: row.state; toggled => { App.tree-check(i); } } }
                            VerticalLayout { alignment: center; Icon { d: row.icon == 0 ? Icons.folder : row.icon == 1 ? Icons.file : row.icon == 2 ? Icons.globe : row.icon == 3 ? Icons.wifi : Icons.apps; size: 18px; tint: row.icon == 1 ? Theme.sub : Theme.accent; } }
                            Text { text: row.label; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-alignment: Theme.start; }
                            Text { text: row.size; color: Theme.sub; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout { alignment: center; Text { text: Tr.conflict; color: Theme.sub; font-size: 13px; } }
                VerticalLayout { alignment: center; ComboBox { model: [Tr.ask, Tr.overwrite, Tr.skip, Tr.keep-both, Tr.overwrite-older]; current-index <=> App.policy; width: 200px; } }
                Field { text <=> App.drive-map; placeholder: Tr.drive-map; width: 150px; }
                Field { text <=> App.restore-root; placeholder: Tr.other-root; }
                IconButton { icon: Icons.folder; width: 38px; height: 38px; clicked => { App.browse-root(); } }
            }
            Text { text: App.resolved-path == "" ? "" : Tr.resolved + ": " + App.resolved-path; color: Theme.sub; font-size: 12px; overflow: elide; horizontal-alignment: Theme.start; }
            Card {
                height: 72px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.green; } }
                    Text { text: App.restore-footer; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-alignment: Theme.start; }
                    VerticalLayout { alignment: center; PButton { text: Tr.do-restore; icon: Icons.restore; width: 160px; height: 44px; enabled: !App.busy; clicked => { App.start-restore(); } } }
                }
            }
        }
    }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    VerticalLayout { alignment: center; Text { text: label; color: Theme.text; font-size: 14px; width: 220px; horizontal-alignment: Theme.start; } }
}

export component SettingsPage inherits Rectangle {
    VerticalLayout {
        spacing: 14px;
        PageHeader { icon: Icons.settings; title: Tr.settings; sub: Tr.settings-sub; }
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;
                Row { label: Tr.output-folder; Field { text <=> App.out-dir; edited(t) => { App.settings-changed(); } } IconButton { icon: Icons.folder; width: 38px; height: 38px; clicked => { App.browse-output(); } } }
                Row { label: Tr.default-compression; ComboBox { model: [Tr.fast, Tr.recommended, Tr.maximum]; current-index <=> App.default-level; selected(v) => { App.settings-changed(); } } }
                Row { label: Tr.default-excludes; Field { text <=> App.default-excludes; edited(t) => { App.settings-changed(); } } }
                Row { label: Tr.theme; ComboBox { model: [Tr.system, Tr.dark, Tr.light]; current-index <=> App.theme-index; selected(v) => { App.settings-changed(); } } }
                Row { label: Tr.language; ComboBox { model: ["English", "العربية"]; current-index <=> App.language-index; selected(v) => { App.settings-changed(); } } }
                Row { label: Tr.conflict-default; ComboBox { model: [Tr.ask, Tr.overwrite, Tr.skip, Tr.keep-both, Tr.overwrite-older]; current-index <=> App.default-policy; selected(v) => { App.settings-changed(); } } }
                HorizontalLayout { alignment: Theme.rtl ? end : start; PButton { text: Tr.export-log; icon: Icons.file; primary: false; width: 170px; clicked => { App.export-log(); } } }
            }
        }
    }
}
