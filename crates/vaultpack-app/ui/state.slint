export struct ItemRow { name: string, detail: string, folder: bool }
export struct TreeRow { depth: int, label: string, size: string, state: int, has-children: bool, expanded: bool, icon: int }
export struct BrowserRow { label: string, size: string, checked: bool, running: bool }

