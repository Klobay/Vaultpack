export global App {
    in-out property <int> page: 0;
    in-out property <string> status: "Ready";
    in-out property <int> status-kind: 0;
    in-out property <bool> dragging: false;
    in-out property <[ItemRow]> items;
    in-out property <string> password;
    in-out property <bool> show-password: false;
    in-out property <int> level: 1;
    in-out property <string> excludes;
    in-out property <bool> preset-browsers: false;
    in-out property <bool> preset-wifi: false;
    in-out property <bool> preset-programs: false;
    in-out property <[BrowserRow]> browser-rows;
    in-out property <bool> browser-running: false;
    in-out property <bool> need-admin: false;
    in-out property <string> scan-info;

    in-out property <bool> archive-open: false;
    in-out property <bool> needs-password: false;
    in-out property <string> archive-name;
    in-out property <string> archive-password;
    in-out property <string> search;
    in-out property <[TreeRow]> tree-rows;
    in-out property <string> restore-footer;
    in-out property <int> policy: 0;
    in-out property <string> restore-root;
    in-out property <string> drive-map;
    in-out property <string> resolved-path;

    in-out property <string> out-dir;
    in-out property <int> default-level: 1;
    in-out property <string> default-excludes;
    in-out property <int> theme-index: 0;
    in-out property <int> language-index: 0;
    in-out property <int> default-policy: 0;

    in-out property <bool> busy: false;
    in-out property <bool> paused: false;
    in-out property <string> job-title;
    in-out property <string> job-status;
    in-out property <float> overall: 0;
    in-out property <float> file-progress: 0;
    in-out property <string> current-file;
    in-out property <string> speed;
    in-out property <string> eta;
    in-out property <string> counters;

    in-out property <bool> summary-open: false;
    in-out property <string> summary-title;
    in-out property <string> summary-text;
    in-out property <bool> summary-has-manual: false;
    in-out property <bool> maximized: false;
    in-out property <string> version: "v1.0.0";

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback drag-window();
    callback resize-window(int);
    callback add-files();
    callback add-folder();
    callback remove-item(int);
    callback start-backup();
    callback save-profile();
    callback load-profile();
    callback preset-changed(int, bool);
    callback browser-toggled(int, bool);
    callback close-browsers();
    callback relaunch-admin();
    callback add-exclude-preset(int);
    callback open-archive();
    callback unlock();
    callback close-archive();
    callback search-changed(string);
    callback tree-check(int);
    callback tree-expand(int);
    callback tree-select(int);
    callback tree-bulk(int);
    callback start-restore();
    callback browse-root();
    callback browse-output();
    callback settings-changed();
    callback pause-toggle();
    callback cancel-job();
    callback close-summary();
    callback export-log();
    callback export-programs();
}
